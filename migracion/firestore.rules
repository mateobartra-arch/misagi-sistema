rules_version = '2';
// ==========================================================================
// MISAGI S.A.C. — Reglas de seguridad de Firestore
// Subir con:  firebase deploy --only firestore:rules
// Principio: NADA es accesible sin sesión, y cada módulo solo lo ve quien
// tiene el área correspondiente en su documento de usuario.
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function logueado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function activo() { return logueado() && perfil().activo == true; }
    function esAdmin() { return activo() && ('admin' in perfil().areas); }
    function tieneArea(a) { return activo() && (esAdmin() || (a in perfil().areas)); }

    // ---- usuarios: perfil + permisos ----
    match /usuarios/{uid} {
      allow read: if request.auth.uid == uid || esAdmin();
      allow create, update, delete: if esAdmin();   // alta/baja solo admin
    }

    // ---- Asistencia (área rrhh) ----
    match /asistencia/{doc} {
      allow create: if logueado() && request.resource.data.uid == request.auth.uid;
      allow read:   if tieneArea('rrhh');           // admin/RRHH ven todo; ver propio se filtra en cliente
      allow update, delete: if esAdmin();
    }

    // ---- Solicitudes del personal (vacaciones, cambios de datos) ----
    // Cada quien crea y lee SUS propias solicitudes; el admin las ve y resuelve.
    match /solicitudes/{doc} {
      allow create: if logueado() && request.resource.data.uid == request.auth.uid;
      allow read:   if logueado() && (esAdmin() || resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // ---- Accesos directos (enlaces de Drive): todos los logueados leen;
    // solo el admin agrega/edita/borra. El filtro por área es en el cliente. ----
    match /enlaces/{doc} {
      allow read:  if logueado();
      allow write: if esAdmin();
    }

    // ---- Preferencias personales de accesos directos (nombre/orden propio) ----
    match /prefs_enlaces/{uid} {
      allow read, write: if logueado() && request.auth.uid == uid;
    }

    // ---- Roster de conductores: Operaciones escribe y ve todo; cada
    // conductor lee SOLO sus propios días (por su DNI). ----
    match /roster/{doc} {
      allow read:  if tieneArea('operaciones') || (activo() && resource.data.dni == perfil().dni);
      allow write: if tieneArea('operaciones');
    }

    // ---- Lista de conductores del roster (Operaciones la administra) ----
    match /roster_conductores/{doc} {
      allow read:  if logueado();
      allow write: if tieneArea('operaciones');
    }

    // ---- Gestión documentaria (unidades y conductores) ----
    match /documentos/{doc} {
      allow read, write: if tieneArea('operaciones') || tieneArea('rrhh');
    }

    // ---- Configuración (correos de alertas, etc.) ----
    match /config/{doc} {
      allow read:  if logueado();
      allow write: if esAdmin();
    }

    // ---- Colecciones por área (módulos futuros) ----
    match /operaciones/{doc}    { allow read, write: if tieneArea('operaciones'); }
    match /mantenimiento/{doc}  { allow read, write: if tieneArea('mantenimiento'); }
    match /rrhh/{doc}           { allow read, write: if tieneArea('rrhh'); }
    match /finanzas/{doc}       { allow read, write: if tieneArea('finanzas'); }
    match /contabilidad/{doc}   { allow read, write: if tieneArea('contabilidad'); }
    match /proveedores/{doc}    { allow read, write: if tieneArea('proveedores'); }
    match /planificacion/{doc}  { allow read, write: if tieneArea('planificacion'); }
    match /imagen/{doc}         { allow read, write: if tieneArea('imagen'); }
    match /ssoma/{doc}          { allow read, write: if tieneArea('ssoma'); }
    match /comercial/{doc}      { allow read, write: if tieneArea('comercial'); }
    match /presupuesto/{doc}    { allow read, write: if tieneArea('presupuesto'); }

    // Todo lo no declarado queda BLOQUEADO por defecto.
    match /{document=**} { allow read, write: if false; }
  }
}
