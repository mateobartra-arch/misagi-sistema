rules_version = '2';
// ==========================================================================
// MISAGI S.A.C. — Reglas de Firebase Storage (endurecidas en auditoría)
// Pegar en consola: Storage → Rules → Publicar.
// Cambios vs versión anterior:
//   • Subir archivos ya NO lo puede hacer cualquier usuario con sesión:
//     solo Operaciones / RRHH / Admin (se valida contra el perfil en Firestore).
//   • Solo se aceptan imágenes y PDF, hasta 15 MB.
// ==========================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function activo() { return request.auth != null && perfil().activo == true; }
    function area(a)  { return activo() && (('admin' in perfil().areas) || (a in perfil().areas)); }

    // Documentos del sistema (fichas de unidades/conductores)
    match /documentos/{allPaths=**} {
      allow read:  if request.auth != null;                       // cualquier usuario con sesión puede ver
      allow write: if (area('operaciones') || area('rrhh'))       // solo quien gestiona flota/personal sube
                   && request.resource.size < 15 * 1024 * 1024     // tope 15 MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Todo lo demás, bloqueado.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
